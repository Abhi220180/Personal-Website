{
  "name": "abhinav-editorial-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:assets && npm run build:stop && node scripts/build-safe.cjs",
    "build:stop": "node scripts/build-stop.cjs",
    "build:direct": "next build",
    "check": "npm run lint && npm run typecheck && npm run validate:assets",
    "generate:company-logos": "node scripts/generate-company-logo-models.mjs && npm run optimize:models",
    "lint": "next lint",
    "optimize:models": "node scripts/optimize-models.cjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:assets": "node scripts/validate-assets.cjs"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.2.1",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
